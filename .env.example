# Copy to .env (never commit .env). Railway sets these for you in the cloud.
# Required: Crossr reads all data from Postgres. Locally use the crossr_dev database
# (Railway -> Postgres -> Connect -> "Public network" URL, with /crossr_dev at the end):
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/crossr_dev

# Frontend origin(s) allowed to call the API (comma separated)
CROSSR_FRONTEND_ORIGIN=http://localhost:3000


# Production only: HTTPS session cookies
# CROSSR_SECURE_COOKIES=1

# Optional tuning (defaults shown)
# CROSSR_DB_VERSION_TTL=15        # seconds between table-version checks
# CROSSR_SALES_MODEL=1            # 0 = fee-band price projection instead of the sales model
# CROSSR_STAGE=state/stage.sqlite # pipeline's local staging database

# Web (Next.js)
# API_INTERNAL=http://127.0.0.1:8000   # where the web server proxies /api
# NEXT_PUBLIC_API_URL=                 # absolute API URL for the browser (default same origin)
